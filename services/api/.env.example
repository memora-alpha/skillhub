PORT=3001
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=info
STORAGE_ENABLED=false

# Set all provider values and enable only when private S3-compatible storage is configured.
# Use HTTPS endpoints and managed secrets in production.
# STORAGE_ENDPOINT=https://objects.example.invalid
# STORAGE_REGION=region-1
# Avatar, CHAT files and Evidence share S3_BUCKET below.
# STORAGE_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
# STORAGE_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
# CLAMAV_HOST and CLAMAV_PORT below are shared with identity avatar scanning.

# Example endpoints. Set credentials and addresses for your development environment.
DATABASE_URL=postgresql://skillhub:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/skillhub
MONGODB_URI=mongodb://127.0.0.1:27018/skillhub_chat?replicaSet=rs0&directConnection=true

# Connection defaults: proposal 7 days, 10/hour and 50/day; direct cooldown 24h.
# Chat: 30/min/user, 120/min/conversation; 5 files, 15 MB/file, 50 MB total.
# Optional hints remain unavailable unless their business bounds are configured.
# CONNECTION_SESSION_COUNT_MAX=
# CONNECTION_ONE_WAY_MIN=
# CONNECTION_ONE_WAY_MAX=
# Separate >=32-byte random signing key recommended; otherwise uses IDENTITY_JWT_KEY.
# EVENT_CURSOR_KEY=
# SSE operational defaults; these do not change the approved business send quotas.
# EVENT_HEARTBEAT_MS=15000
# EVENT_RETRY_MS=3000
# EVENT_BUFFER_BYTES=262144
# EVENT_DRAIN_TIMEOUT_MS=5000
# EVENT_REPLAY_MAX_ROWS=10000
# EVENT_CONNECTIONS_PER_USER=3
# EVENT_CONNECTIONS_PER_SESSION=2
# EVENT_CONNECTIONS_PER_IP=20
# EVENT_CONNECTIONS_GLOBAL=1000
# Local Redis example. For hosted Redis, use the provider URI and required TLS.
REDIS_URL=redis://127.0.0.1:6379/0
# Docker Compose uses PostgreSQL 5433, MongoDB 27018 and Redis 6380; see README.

# Identity runtime requires explicit policy values; blank fields intentionally prevent startup.
# Generate three distinct random secrets; OTP/encryption keys are exactly 32 bytes in base64.
IDENTITY_JWT_KEY=
IDENTITY_OTP_KEY=
IDENTITY_ENCRYPTION_KEY=
IDENTITY_KEY_ID=
# Optional JSON key ring for draining prior OTP/outbox records after key rotation.
# {"old-key-id":{"otpKey":"BASE64_32_BYTES","encryptionKey":"BASE64_32_BYTES"}}
IDENTITY_PREVIOUS_KEYS=
IDENTITY_JWT_ISSUER=
IDENTITY_JWT_AUDIENCE=
IDENTITY_TERMS_VERSION=
IDENTITY_DEFAULT_TIMEZONE=
# Required 0..100 in production; blank means uninitialized in development/test.
IDENTITY_INITIAL_REPUTATION=
IDENTITY_ACCESS_SECONDS=
IDENTITY_REFRESH_SECONDS=
IDENTITY_REMEMBER_SECONDS=
IDENTITY_RESET_SECONDS=
IDENTITY_REAUTH_SECONDS=
IDENTITY_THROTTLE_WINDOW_SECONDS=
IDENTITY_EMAIL_RATE_LIMIT=
IDENTITY_IP_RATE_LIMIT=
IDENTITY_DEVICE_RATE_LIMIT=
IDENTITY_REQUEST_RATE_LIMIT=
IDENTITY_DELIVERY_ATTEMPTS=
IDENTITY_DELIVERY_RETENTION_SECONDS=
IDENTITY_NOTIFICATION_SECONDS=
IDENTITY_AVATAR_RETENTION_SECONDS=

# Optional operator-only Admin creation: node scripts/create-admin.mjs.
# Set as runtime secrets in Coolify or in an ignored local .env; never at build time.
# No account is created automatically at application startup.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Optional, defaults to SkillHub Admin and a fixed operator reason when blank.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_REASON=

# payOS capability remains disabled until channel and posting flows are ready.
PAYMENTS_ENABLED=false
# Pause fresh orders during restore/channel reconciliation; keep webhook/worker enabled.
PAYMENT_CREATION_PAUSED=false
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Required by payOS create/signature even for QR-only checkout; server-side only.
# SkillHub renders qrCode directly and does not navigate to hosted checkout.
PAYOS_RETURN_URL=
PAYOS_CANCEL_URL=

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Event notifications: comma list of IN_APP, EMAIL, PUSH (OP-05 open; in-app only by default).
NOTIFICATION_CHANNELS=IN_APP
# Firebase Cloud Messaging service account for web push; required when PUSH is enabled.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=skillhub
S3_ACCESS_KEY=
S3_SECRET_KEY=
CLAMAV_HOST=
CLAMAV_PORT=

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=