{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "predev": "prisma generate",
    "dev": "nest start --watch",
    "prebuild": "prisma generate",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint . --max-warnings 0",
    "check-types": "prisma generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "test:foundation": "node --test test/foundation.test.mjs",
    "test:rbac": "nest build && node --test test/authorization.test.mjs test/authorization-http.test.mjs"
  },
  "dependencies": {
    "@nestjs/bullmq": "11.0.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/mongoose": "11.0.0",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "11.4.4",
    "@nestjs/throttler": "6.5.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "bullmq": "5.77.6",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.0.0",
    "helmet": "8.2.0",
    "ioredis": "5.11.0",
    "mongoose": "8.19.0",
    "nestjs-pino": "4.6.0",
    "pg": "8.21.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@skillhub/eslint-config": "workspace:*",
    "@skillhub/typescript-config": "workspace:*",
    "@types/express": "5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "8.20.0",
    "eslint": "^9.39.1",
    "prisma": "7.8.0",
    "typescript": "6.0.3"
  }
}
