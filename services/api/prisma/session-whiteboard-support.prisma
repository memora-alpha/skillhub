// Session whiteboard fragments (spec 019).
model SessionWhiteboard {
  id              String   @id @default(uuid()) @db.Uuid
  sessionId       String   @unique @map("session_id") @db.Uuid
  revision        Int      @default(0)
  // Excalidraw scene { elements, appState?, files? }; size is bounded by the service.
  sceneData       Json     @map("scene_data")
  sceneBytes      Int      @map("scene_bytes")
  updatedByUserId String   @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  session   Session @relation("SessionWhiteboard_session", fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy User    @relation("SessionWhiteboard_updated_by", fields: [updatedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([updatedByUserId])
  @@map("session_whiteboards")
}
