enum OtpPurpose {
  REGISTER
  RESET_PASSWORD
  CHANGE_EMAIL
}

enum IdentityEmailKind {
  REGISTER_OTP
  RESET_OTP
  PASSWORD_CHANGED
}

model OtpChallenge {
  id              String                  @id @default(uuid()) @db.Uuid
  userId          String                  @map("user_id") @db.Uuid
  purpose         OtpPurpose
  email           String                  @db.VarChar(254)
  verifierDigest  Bytes                   @map("verifier_digest") @db.ByteA
  verifierKeyId   String                  @map("verifier_key_id") @db.Text
  expiresAt       DateTime                @map("expires_at") @db.Timestamptz(3)
  consumedAt      DateTime?               @map("consumed_at") @db.Timestamptz(3)
  supersededAt    DateTime?               @map("superseded_at") @db.Timestamptz(3)
  failedAttempts  Int                     @default(0) @map("failed_attempts")
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  user            User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  emailDeliveries IdentityEmailDelivery[]

  // Outstanding-challenge partial uniqueness belongs in the SQL migration.
  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}

model OtpIssueWindow {
  normalizedEmail String     @map("normalized_email") @db.VarChar(254)
  purpose         OtpPurpose
  windowStart     DateTime   @map("window_start") @db.Timestamptz(3)
  issueCount      Int        @default(0) @map("issue_count")
  resendCount     Int        @default(0) @map("resend_count")
  lastIssuedAt    DateTime   @map("last_issued_at") @db.Timestamptz(3)

  @@id([normalizedEmail, purpose, windowStart])
  @@index([windowStart])
  @@map("otp_issue_windows")
}

model IdempotencyRecord {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope           String
  operation       String
  keyDigest       String    @map("key_digest")
  fingerprint     String
  resultReference Json?     @map("result_reference")
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([scope, operation, keyDigest])
  @@map("idempotency_records")
}

model OutboxConsumerReceipt {
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([consumer, eventId])
  @@map("outbox_consumer_receipts")
}

model SystemConfigurationRevision {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key           String
  value         Json
  version       Int
  effectiveAt   DateTime            @map("effective_at") @db.Timestamptz(3)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  actorSnapshot Json                @map("actor_snapshot")
  auditId       String?             @map("audit_id") @db.Uuid
  configuration SystemConfiguration @relation(fields: [key], references: [key], onDelete: Restrict)

  @@unique([key, version])
  @@index([key, createdAt(sort: Desc)])
  @@map("system_configuration_revisions")
}

model StoredFile {
  id                String                @id @db.Uuid
  purpose           String
  uploadedBy        String                @map("uploaded_by") @db.Uuid
  objectKey         String                @unique @map("object_key")
  generation        Int                   @default(1)
  originalName      String                @map("original_name")
  detectedMime      String?               @map("detected_mime")
  sizeBytes         Int?                  @map("size_bytes")
  sha256            String?
  state             String
  scanAttempts      Int                   @default(0) @map("scan_attempts")
  scanVerdict       String?               @map("scan_verdict")
  scannerVersion    String?               @map("scanner_version")
  scannedAt         DateTime?             @map("scanned_at") @db.Timestamptz(3)
  scanLeaseToken    String?               @map("scan_lease_token") @db.Uuid
  scanLeaseUntil    DateTime?             @map("scan_lease_until") @db.Timestamptz(3)
  providerVersionId String?               @map("provider_version_id")
  failureCode       String?               @map("failure_code")
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  scanEvents        StoredFileScanEvent[]

  @@index([state, createdAt])
  @@index([scanLeaseUntil])
  @@map("stored_files")
}

model StoredFileScanEvent {
  id             String     @id @db.Uuid
  fileId         String     @map("file_id") @db.Uuid
  generation     Int
  attempt        Int
  leaseToken     String     @unique(map: "stored_file_scan_events_unique_lease") @map("lease_token") @db.Uuid
  verdict        String
  scannerVersion String     @map("scanner_version")
  failureCode    String?    @map("failure_code")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  file           StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "stored_file_scan_events_file_fkey")

  @@index([fileId, createdAt], map: "stored_file_scan_events_file_created_idx")
  @@map("stored_file_scan_events")
}

// SRS V1.6 requires Learning Request tags beyond the logical v3 diagram.
enum RequestModerationStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum RequestExpiryMode {
  DEFAULT
  CUSTOM
}

model Tag {
  id String @id @default(uuid()) @map("tag_id") @db.Uuid
  label String @unique @db.VarChar(80)
  status CatalogStatus @map("status")
  learningRequests RequestTag[] @relation("RequestTag_tag")

  @@map("tags")
}

model RequestTag {
  requestId String @map("request_id") @db.Uuid
  tagId String @map("tag_id") @db.Uuid
  request LearningRequest @relation("RequestTag_request", fields: [requestId], references: [id], onDelete: Restrict)
  tag Tag @relation("RequestTag_tag", fields: [tagId], references: [id], onDelete: Restrict)

  @@id([requestId, tagId])
  @@index([tagId, requestId])
  @@map("learning_request_tags")
}
