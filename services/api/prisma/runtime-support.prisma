// Payment technical records. SQL migration owns foreign keys to existing domain tables.
model PayosCheckout {
  paymentId String @id @map("payment_id") @db.Uuid
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  channel String @db.VarChar(100)
  orderCode BigInt @unique @default(autoincrement()) @map("order_code")
  paymentLinkId String? @map("payment_link_id") @db.VarChar(255)
  qrCode String? @map("qr_code") @db.VarChar(4096)
  state String @default("PREPARING") @db.VarChar(24)
  version Int @default(1)
  quoteDigest String @map("quote_digest") @db.Char(64)
  policyVersion String @map("policy_version") @db.VarChar(40)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  paidAt DateTime? @map("paid_at") @db.Timestamptz(3)
  topUpOperationId String? @unique @map("top_up_operation_id") @db.Uuid
  lastError String? @map("last_error") @db.VarChar(80)
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(3)
  leaseToken String? @map("lease_token") @db.Uuid
  returnUrl String @map("return_url") @db.Text
  cancelUrl String @map("cancel_url") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@unique([channel, paymentLinkId])
  @@index([nextAttemptAt])
  @@map("payos_checkouts")
}

model PaymentReceipt {
  id String @id @default(uuid()) @db.Uuid
  channel String @db.VarChar(100)
  transactionId String @map("transaction_id") @db.VarChar(255)
  digest String @db.Char(64)
  evidence Json
  paymentId String? @map("payment_id") @db.Uuid
  state String @db.VarChar(24)
  reason String? @db.VarChar(80)
  conflict Boolean @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@unique([channel, transactionId])
  @@index([paymentId])
  @@map("payment_receipts")
}

model CreditLot {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  operationId String @unique @map("operation_id") @db.Uuid
  source String @db.VarChar(20)
  available BigInt
  held BigInt @default(0)
  consumed BigInt @default(0)
  granted BigInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([userId, createdAt, id])
  @@map("credit_lots")
}

model PaymentFinding {
  id String @id @default(uuid()) @db.Uuid
  receiptId String @map("receipt_id") @db.Uuid
  digest String @db.Char(64)
  evidence Json
  reason String @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@unique([receiptId,digest])
  @@map("payment_findings")
}

model CreditLotHold {
  allocationId String @map("allocation_id") @db.Uuid
  lotId String @map("lot_id") @db.Uuid
  amount BigInt
  remaining BigInt
  @@id([allocationId, lotId])
  @@map("credit_lot_holds")
}

// Per-skill level catalog; legacy SharingSkill.level stays during client rollout.
model SkillLevel {
  id String @id @default(uuid()) @map("level_id") @db.Uuid
  skillId String @map("skill_id") @db.Uuid
  code String @db.VarChar(40)
  name String @db.VarChar(100)
  nameKey String @map("name_key") @db.Text
  description String? @db.VarChar(500)
  sortOrder Int @default(0) @map("sort_order")
  status CatalogStatus @default(ACTIVE)
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sharingSkills SharingSkill[]

  @@unique([skillId, id])
  @@unique([skillId, code])
  @@unique([skillId, nameKey])
  @@index([skillId, status, sortOrder, id])
  @@map("skill_levels")
}

enum OtpPurpose {
  REGISTER
  RESET_PASSWORD
  CHANGE_EMAIL
}

enum IdentityEmailKind {
  REGISTER_OTP
  RESET_OTP
  PASSWORD_CHANGED
}

model IdempotencyRecord {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope           String
  operation       String
  keyDigest       String    @map("key_digest")
  fingerprint     String
  resultReference Json?     @map("result_reference")
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([scope, operation, keyDigest])
  @@map("idempotency_records")
}

model OutboxConsumerReceipt {
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([consumer, eventId])
  @@map("outbox_consumer_receipts")
}

model SystemConfigurationRevision {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key           String
  value         Json
  version       Int
  effectiveAt   DateTime            @map("effective_at") @db.Timestamptz(3)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  actorSnapshot Json                @map("actor_snapshot")
  auditId       String?             @map("audit_id") @db.Uuid
  configuration SystemConfiguration @relation(fields: [key], references: [key], onDelete: Restrict)

  @@unique([key, version])
  @@index([key, createdAt(sort: Desc)])
  @@map("system_configuration_revisions")
}

model StoredFile {
  id                String                @id @db.Uuid
  purpose           String
  uploadedBy        String                @map("uploaded_by") @db.Uuid
  objectKey         String                @unique @map("object_key")
  generation        Int                   @default(1)
  originalName      String                @map("original_name")
  detectedMime      String?               @map("detected_mime")
  sizeBytes         Int?                  @map("size_bytes")
  sha256            String?
  state             String
  scanAttempts      Int                   @default(0) @map("scan_attempts")
  scanVerdict       String?               @map("scan_verdict")
  scannerVersion    String?               @map("scanner_version")
  scannedAt         DateTime?             @map("scanned_at") @db.Timestamptz(3)
  scanLeaseToken    String?               @map("scan_lease_token") @db.Uuid
  scanLeaseUntil    DateTime?             @map("scan_lease_until") @db.Timestamptz(3)
  providerVersionId String?               @map("provider_version_id")
  failureCode       String?               @map("failure_code")
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  scanEvents        StoredFileScanEvent[]
  attachedAt        DateTime? @map("attached_at") @db.Timestamptz(3)
  resourceType      String? @map("resource_type")
  resourceId        String? @map("resource_id") @db.Uuid
  evidence          SkillEvidence?

  @@index([state, createdAt])
  @@index([scanLeaseUntil])
  @@map("stored_files")
}

model StoredFileScanEvent {
  id             String     @id @db.Uuid
  fileId         String     @map("file_id") @db.Uuid
  generation     Int
  attempt        Int
  leaseToken     String     @unique(map: "stored_file_scan_events_unique_lease") @map("lease_token") @db.Uuid
  verdict        String
  scannerVersion String     @map("scanner_version")
  failureCode    String?    @map("failure_code")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  file           StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "stored_file_scan_events_file_fkey")

  @@index([fileId, createdAt], map: "stored_file_scan_events_file_created_idx")
  @@map("stored_file_scan_events")
}

// SRS V1.6 requires Learning Request tags beyond the logical v3 diagram.
model ChatPublication {
  id String @id @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid
  senderId String @map("sender_id") @db.Uuid
  clientMessageId String @map("client_message_id") @db.Uuid
  commandDigest String @map("command_digest")
  draftDigest String? @map("draft_digest")
  draftFormatVersion Int @default(1) @map("draft_format_version")
  deliveredEventId String @unique @map("delivered_event_id") @db.Uuid
  status String @default("PREPARING")
  messageSequence BigInt? @map("message_sequence")
  failureCode String? @map("failure_code")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@unique([conversationId, senderId, clientMessageId])
  @@index([status, createdAt])
  @@index([senderId, createdAt])
  @@map("chat_publications")
}

model UserEventStream {
  userId String @id @map("user_id") @db.Uuid
  epoch String @default(uuid()) @db.Uuid
  lastSequence BigInt @default(0) @map("last_sequence")
  firstRetainedSequence BigInt @default(1) @map("first_retained_sequence")
  @@map("user_event_streams")
}

model UserEventDelivery {
  userId String @map("user_id") @db.Uuid
  sequence BigInt
  eventId String @map("event_id") @db.Uuid
  type String
  version Int @default(1)
  payload Json
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  @@id([userId, sequence])
  @@unique([userId, eventId])
  @@map("user_event_deliveries")
}

enum RequestModerationStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum RequestExpiryMode {
  DEFAULT
  CUSTOM
}

model Tag {
  id String @id @default(uuid()) @map("tag_id") @db.Uuid
  label String @unique @db.VarChar(80)
  status CatalogStatus @map("status")
  labelKey String @unique @map("label_key") @db.Text
  createdByUserId String? @map("created_by_user_id") @db.Uuid
  createdBy User? @relation("Tag_creator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "tags_creator_fkey")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version Int @default(1)
  creationRequests TagCreationRequest[]
  learningRequests RequestTag[] @relation("RequestTag_tag")

  @@index([createdByUserId])
  @@map("tags")
}

enum TagCreationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model TagCreationRequest {
  id String @id @default(uuid()) @map("tag_request_id") @db.Uuid
  label String @db.VarChar(80)
  labelKey String @map("label_key") @db.Text
  requestedByUserId String @map("requested_by_user_id") @db.Uuid
  requestedBy User @relation("TagRequest_owner", fields: [requestedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  status TagCreationRequestStatus @default(PENDING)
  reviewedByUserId String? @map("reviewed_by_user_id") @db.Uuid
  reviewedBy User? @relation("TagRequest_reviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(3)
  resultTagId String? @map("result_tag_id") @db.Uuid
  resultTag Tag? @relation(fields: [resultTagId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rejectReason String? @map("reject_reason") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version Int @default(1)

  @@index([status, createdAt(sort: Desc), id(sort: Desc)], map: "tag_request_queue_idx")
  @@index([requestedByUserId, createdAt(sort: Desc), id(sort: Desc)], map: "tag_request_owner_idx")
  @@index([reviewedByUserId], map: "tag_request_reviewer_idx")
  @@index([resultTagId], map: "tag_request_result_idx")
  @@map("tag_creation_requests")
}

model RequestTag {
  requestId String @map("request_id") @db.Uuid
  tagId String @map("tag_id") @db.Uuid
  request LearningRequest @relation("RequestTag_request", fields: [requestId], references: [id], onDelete: Restrict)
  tag Tag @relation("RequestTag_tag", fields: [tagId], references: [id], onDelete: Restrict)

  @@id([requestId, tagId])
  @@index([tagId, requestId])
  @@map("learning_request_tags")
}

// User-approved FE extension; offered skills remain owned by Sharing Skills.
model RequestOffering {
  requestId String @map("request_id") @db.Uuid
  sharingSkillId String @map("sharing_skill_id") @db.Uuid
  request LearningRequest @relation("RequestOffering_request", fields: [requestId], references: [id], onDelete: Restrict, map: "learning_request_offerings_request_fkey")
  sharingSkill SharingSkill @relation("RequestOffering_sharing", fields: [sharingSkillId], references: [id], onDelete: Restrict, map: "learning_request_offerings_sharing_fkey")

  @@id([requestId, sharingSkillId])
  @@index([sharingSkillId, requestId], map: "learning_request_offerings_sharing_idx")
  @@map("learning_request_offerings")
}

enum AttendanceRole {
  TEACHER
  LEARNER
}

enum AttendanceCloseSource {
  WEBHOOK
  HEARTBEAT
  ROOM_FINISHED
}

enum AttendanceVerdict {
  PRESENT
  ABSENT
  UNVERIFIABLE
}

enum AttendanceCase {
  BOTH_PRESENT
  TEACHER_ABSENT
  LEARNER_ABSENT
  BOTH_ABSENT
  UNVERIFIABLE
}

enum AttendanceOutcomeStatus {
  PROVISIONAL
  FINAL
  EXCUSED
  DISPUTED
  OVERTURNED
}

enum SessionResolution {
  COMPLETED_MUTUAL
  COMPLETED_TIMEOUT
  COMPLETED_LEARNER_NO_SHOW
  COMPLETED_STAFF
  MAKEUP_REQUIRED
  STAFF_REVIEW
}

enum AbsenceExcuseStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

/// One LiveKit connection (participant SID) of a Session participant.
model SessionAttendanceInterval {
  id             String                 @id @default(uuid()) @map("interval_id") @db.Uuid
  sessionId      String                 @map("session_id") @db.Uuid
  session        Session                @relation("AttendanceInterval_session", fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  userId         String                 @map("user_id") @db.Uuid
  user           User                   @relation("AttendanceInterval_user", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role           AttendanceRole
  roomSid        String                 @map("room_sid") @db.Text
  participantSid String                 @map("participant_sid") @db.Text
  joinedAt       DateTime               @map("joined_at") @db.Timestamptz(3)
  leftAt         DateTime?              @map("left_at") @db.Timestamptz(3)
  lastSeenAt     DateTime               @map("last_seen_at") @db.Timestamptz(3)
  closeSource    AttendanceCloseSource? @map("close_source")

  @@unique([sessionId, participantSid])
  @@index([sessionId, userId])
  @@index([userId])
  @@map("session_attendance_intervals")
}

/// Attendance decision for one occurrence (startAt) of a Session; a makeup creates a new row.
model SessionAttendanceOutcome {
  id                   String                  @id @default(uuid()) @map("outcome_id") @db.Uuid
  sessionId            String                  @map("session_id") @db.Uuid
  session              Session                 @relation("AttendanceOutcome_session", fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  occurrenceStartAt    DateTime                @map("occurrence_start_at") @db.Timestamptz(3)
  occurrenceEndAt      DateTime                @map("occurrence_end_at") @db.Timestamptz(3)
  teacherVerdict       AttendanceVerdict       @map("teacher_verdict")
  learnerVerdict       AttendanceVerdict       @map("learner_verdict")
  teacherLate          Boolean                 @map("teacher_late")
  learnerLate          Boolean                 @map("learner_late")
  teacherSeconds       BigInt                  @map("teacher_seconds")
  learnerSeconds       BigInt                  @map("learner_seconds")
  teacherFirstJoinedAt DateTime?               @map("teacher_first_joined_at") @db.Timestamptz(3)
  learnerFirstJoinedAt DateTime?               @map("learner_first_joined_at") @db.Timestamptz(3)
  attendanceCase       AttendanceCase          @map("attendance_case")
  status               AttendanceOutcomeStatus
  resolution           SessionResolution?
  determinedAt         DateTime                @map("determined_at") @db.Timestamptz(3)
  finalizesAt          DateTime                @map("finalizes_at") @db.Timestamptz(3)
  finalizedAt          DateTime?               @map("finalized_at") @db.Timestamptz(3)
  evidence             Json
  excuse               SessionAbsenceExcuse?

  @@unique([sessionId, occurrenceStartAt])
  @@index([status, finalizesAt])
  @@map("session_attendance_outcomes")
}

model SessionAbsenceExcuse {
  id              String                   @id @default(uuid()) @map("excuse_id") @db.Uuid
  outcomeId       String                   @unique @map("outcome_id") @db.Uuid
  outcome         SessionAttendanceOutcome @relation(fields: [outcomeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  absentUserId    String                   @map("absent_user_id") @db.Uuid
  absentUser      User                     @relation("AbsenceExcuse_absent_user", fields: [absentUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reason          String                   @db.VarChar(1000)
  status          AbsenceExcuseStatus      @default(PENDING)
  decidedByUserId String?                  @map("decided_by_user_id") @db.Uuid
  decidedBy       User?                    @relation("AbsenceExcuse_decider", fields: [decidedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  decidedAt       DateTime?                @map("decided_at") @db.Timestamptz(3)
  decisionNote    String?                  @map("decision_note") @db.VarChar(1000)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([absentUserId])
  @@index([decidedByUserId])
  @@map("session_absence_excuses")
}
