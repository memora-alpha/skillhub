// Runtime fragment for Staff permission overrides.
model UserPermissionOverride {
  userId       String     @map("user_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  effect       String     @db.VarChar(5)
  updatedBy    String     @map("updated_by") @db.Uuid
  updatedAt    DateTime   @default(now()) @map("updated_at") @db.Timestamptz(3)
  user         User       @relation("PermissionOverride_target", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor        User       @relation("PermissionOverride_actor", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([userId, permissionId])
  @@index([permissionId], map: "user_permission_overrides_permission_idx")
  @@index([updatedBy], map: "user_permission_overrides_actor_idx")
  @@map("user_permission_overrides")
}
