// Subscriptions (spec 021): Credit-paid plans and their entitlements.
enum SubscriptionPlanCode {
  CREATOR
  PRO
}

enum SubscriptionInterval {
  MONTH
  YEAR
}

enum SubscriptionPlanStatus {
  DRAFT
  APPROVED
  RETIRED
}

enum SubscriptionStatus {
  ACTIVE
  GRACE
  EXPIRED
}

enum SubscriptionChargeKind {
  PURCHASE
  RENEWAL
  UPGRADE
  RECORDING_ADDON
}

// An approved version is immutable; a price or entitlement change is a new version.
model SubscriptionPlanVersion {
  id               String                 @id @default(uuid()) @db.Uuid
  planCode         SubscriptionPlanCode   @map("plan_code")
  versionNo        Int                    @map("version_no")
  monthPrice       BigInt                 @map("month_price")
  yearPrice        BigInt                 @map("year_price")
  // Validated by domain/plan-entitlements.ts.
  entitlements     Json
  status           SubscriptionPlanStatus @default(DRAFT)
  effectiveAt      DateTime?              @map("effective_at") @db.Timestamptz(3)
  approvedAt       DateTime?              @map("approved_at") @db.Timestamptz(3)
  approvedByUserId String?                @map("approved_by_user_id") @db.Uuid
  createdByUserId  String                 @map("created_by_user_id") @db.Uuid
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  approvedBy    User?              @relation("SubscriptionPlanVersion_approved_by", fields: [approvedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy     User               @relation("SubscriptionPlanVersion_created_by", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subscriptions UserSubscription[] @relation("UserSubscription_plan_version")
  charges       SubscriptionCharge[] @relation("SubscriptionCharge_plan_version")

  @@unique([planCode, versionNo])
  @@index([planCode, status, effectiveAt])
  @@index([approvedByUserId])
  @@index([createdByUserId])
  @@map("subscription_plan_versions")
}

// A partial unique index in the migration allows one ACTIVE or GRACE row per user.
// Expired rows stay as history; subscribing again creates a new row.
model UserSubscription {
  id                   String                @id @default(uuid()) @db.Uuid
  userId               String                @map("user_id") @db.Uuid
  planCode             SubscriptionPlanCode  @map("plan_code")
  planVersionId        String                @map("plan_version_id") @db.Uuid
  interval             SubscriptionInterval
  status               SubscriptionStatus    @default(ACTIVE)
  autoRenew            Boolean               @default(true) @map("auto_renew")
  termStart            DateTime              @map("term_start") @db.Timestamptz(3)
  termEnd              DateTime              @map("term_end") @db.Timestamptz(3)
  graceUntil           DateTime?             @map("grace_until") @db.Timestamptz(3)
  nextRenewalAttemptAt DateTime?             @map("next_renewal_attempt_at") @db.Timestamptz(3)
  scheduledPlanCode    SubscriptionPlanCode? @map("scheduled_plan_code")
  scheduledInterval    SubscriptionInterval? @map("scheduled_interval")
  version              Int                   @default(1)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  endedAt              DateTime?             @map("ended_at") @db.Timestamptz(3)

  user        User                    @relation("UserSubscription_user", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  planVersion SubscriptionPlanVersion @relation("UserSubscription_plan_version", fields: [planVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  charges     SubscriptionCharge[]    @relation("SubscriptionCharge_subscription")
  usage       SubscriptionUsage[]     @relation("SubscriptionUsage_subscription")
  recordings  SessionRecording[]      @relation("SessionRecording_subscription")

  @@index([status, nextRenewalAttemptAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([planVersionId])
  @@map("user_subscriptions")
}

model SubscriptionCharge {
  id             String                 @id @default(uuid()) @db.Uuid
  subscriptionId String                 @map("subscription_id") @db.Uuid
  userId         String                 @map("user_id") @db.Uuid
  kind           SubscriptionChargeKind
  planVersionId  String                 @map("plan_version_id") @db.Uuid
  amount         BigInt
  quantity       Int                    @default(1)
  operationId    String                 @unique @map("operation_id") @db.Uuid
  // SHA-256 of the client key (user routes) or the job key `renewal:<subscriptionId>:<termEnd>`.
  idempotencyKey String                 @map("idempotency_key") @db.VarChar(64)
  // SHA-256 of the canonical request body, to detect key reuse with another body.
  requestDigest  String                 @map("request_digest") @db.VarChar(64)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  subscription UserSubscription        @relation("SubscriptionCharge_subscription", fields: [subscriptionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user         User                    @relation("SubscriptionCharge_user", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  planVersion  SubscriptionPlanVersion @relation("SubscriptionCharge_plan_version", fields: [planVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  operation    CreditOperation         @relation("SubscriptionCharge_operation", fields: [operationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([subscriptionId])
  @@index([planVersionId])
  @@map("subscription_charges")
}

// One row per subscription and 30-day usage period.
model SubscriptionUsage {
  subscriptionId          String   @map("subscription_id") @db.Uuid
  periodStart             DateTime @map("period_start") @db.Timestamptz(3)
  recordingMinutesAllowed Int      @map("recording_minutes_allowed")
  recordingMinutesUsed    Int      @default(0) @map("recording_minutes_used")
  addonMinutesRemaining   Int      @default(0) @map("addon_minutes_remaining")
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  subscription UserSubscription @relation("SubscriptionUsage_subscription", fields: [subscriptionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([subscriptionId, periodStart])
  @@map("subscription_usage")
}
