generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Infrastructure configuration metadata only. Domain tables are introduced per feature.
model SystemConfiguration {
  key String @id
  value Json
  version Int @default(1)
  effectiveAt DateTime @default(now()) @map("effective_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_configurations")
}
