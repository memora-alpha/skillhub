}

// Catalog schema only; owning feature still needs migrations and business invariants.
model OAuthAccount {
  id                String   @id @default(uuid()) @map("oauth_account_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  // Vocabulary remains open in the SRS; validate in the owning feature.
  provider          String   @map("provider") @db.Text
  providerAccountId String   @map("provider_account_id") @db.VarChar(255)
  linkedAt          DateTime @default(now()) @map("linked_at") @db.Timestamptz(3)

  user User @relation("OAuthAccount_user", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

// Catalog schema only; owning feature still needs migrations and business invariants.
model SkillCategory {
  id               String        @id @default(uuid()) @map("category_id") @db.Uuid
  name             String        @unique @map("name") @db.VarChar(100)
  slug             String        @unique @map("slug") @db.VarChar(120)
  status           CatalogStatus @map("status")
  parentCategoryId String?       @map("parent_category_id") @db.Uuid

  parentCategory                SkillCategory?  @relation("SkillCategory_parentCategory", fields: [parentCategoryId], references: [id], onDelete: Restrict)
  SkillCategoryAsParentCategory SkillCategory[] @relation("SkillCategory_parentCategory")
  SkillAsCategory               Skill[]         @relation("Skill_category")

  @@index([parentCategoryId])
  @@map("skill_categories")
}

// Catalog schema only; owning feature still needs migrations and business invariants.
model Skill {
  id          String        @id @default(uuid()) @map("skill_id") @db.Uuid
  name        String        @unique @map("name") @db.VarChar(100)
  slug        String        @unique @map("slug") @db.VarChar(120)
  categoryId  String?       @map("category_id") @db.Uuid
  description String?       @map("description") @db.VarChar(500)
  status      CatalogStatus @map("status")

  category                SkillCategory?     @relation("Skill_category", fields: [categoryId], references: [id], onDelete: Restrict)
  SharingSkillAsSkill     SharingSkill[]     @relation("SharingSkill_skill")
  UserLearnedSkillAsSkill UserLearnedSkill[] @relation("UserLearnedSkill_skill")
  LearningRequestAsSkill  LearningRequest[]  @relation("LearningRequest_skill")
  SessionAsSkill          Session[]          @relation("Session_skill")

  @@index([categoryId])
  @@map("skills")
}

// Catalog owns the canonical tag vocabulary. Learning Requests only reference its IDs.
