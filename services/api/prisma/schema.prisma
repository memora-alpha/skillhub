  sourceType      String    @map("source_type") @db.Text
  sourceId        String    @map("source_id") @db.Text
  appliedByUserId String?   @map("applied_by_user_id") @db.Uuid
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)

  userIdRecord          User  @relation("UserRestriction_user_id", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  appliedByUserIdRecord User? @relation("UserRestriction_applied_by_user_id", fields: [appliedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId])
  @@index([appliedByUserId])
  @@map("user_restrictions")
}

model OutboxEvent {
  eventId       String    @id @default(uuid()) @map("event_id") @db.Uuid
  aggregateType String    @map("aggregate_type") @db.Text
  aggregateId   String    @map("aggregate_id") @db.Text
  version       Int       @map("aggregate_version")
  type          String    @map("event_type") @db.VarChar(100)
  payload       Json      @map("payload")
  dedupeKey     String    @unique @map("dedupe_key") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deliveredAt   DateTime? @map("published_at") @db.Timestamptz(3)
  totalAttempts Int       @default(0) @map("attempts")

  correlationId String    @map("correlation_id") @db.Uuid
  availableAt   DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  leaseToken    String?   @map("lease_token") @db.Uuid
  leaseUntil    DateTime? @map("lease_until") @db.Timestamptz(3)
  cycleAttempts Int       @default(0) @map("cycle_attempts")
  replayCount   Int       @default(0) @map("replay_count")
  failedAt      DateTime? @map("failed_at") @db.Timestamptz(3)
  lastErrorCode String?   @map("last_error_code")

  @@index([availableAt, createdAt])
  @@map("outbox_events")
}

// Support retained for implemented foundation and Learning Request services.
// Payment technical records. SQL migration owns foreign keys to existing domain tables.
model PayosCheckout {
  paymentId        String    @id @map("payment_id") @db.Uuid
  payment          Payment   @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  channel          String    @db.VarChar(100)
  orderCode        BigInt    @unique @default(autoincrement()) @map("order_code")
  paymentLinkId    String?   @map("payment_link_id") @db.VarChar(255)
  qrCode           String?   @map("qr_code") @db.VarChar(4096)
  state            String    @default("PREPARING") @db.VarChar(24)
  version          Int       @default(1)
  quoteDigest      String    @map("quote_digest") @db.Char(64)
  policyVersion    String    @map("policy_version") @db.VarChar(40)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  paidAt           DateTime? @map("paid_at") @db.Timestamptz(3)
  topUpOperationId String?   @unique @map("top_up_operation_id") @db.Uuid
  lastError        String?   @map("last_error") @db.VarChar(80)
  attempts         Int       @default(0)
  nextAttemptAt    DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  leaseUntil       DateTime? @map("lease_until") @db.Timestamptz(3)
  leaseToken       String?   @map("lease_token") @db.Uuid
  returnUrl        String    @map("return_url") @db.Text
  cancelUrl        String    @map("cancel_url") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([channel, paymentLinkId])
  @@index([nextAttemptAt])
  @@map("payos_checkouts")
}

model PaymentReceipt {
