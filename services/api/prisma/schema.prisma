// Runtime: v3 domain models plus implemented foundation support.
// Generated by scripts/generate-runtime-schema.mjs; do not edit directly.
// Credit BigInt amounts use 100 units = 1 Credit.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  LOCKED
  DEACTIVATED
}

enum RoleCode {
  USER
  STAFF
  ADMIN
}

enum UserLocale {
  vi
  en
}

enum CatalogStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SharingSkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum LearningLevel {
  NONE
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum SkillVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum VerificationRequestStatus {
  PENDING
  APPROVED @map("VERIFIED")
  REJECTED
}

enum EvidenceApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

enum ReauthPurpose {
  STAFF_ROLE_CHANGE
}

enum AvatarAssetStatus {
  QUARANTINED
  CLEAN
  REJECTED
  DELETED
}

enum EmailDeliveryStatus {
  PENDING
  LEASED
  SENT
  FAILED
  EXPIRED
  CANCELLED
}

enum LearningRequestStatus {
  DRAFT
  PENDING_MODERATION
  OPEN
  REJECTED
  NEGOTIATING
  MATCHED
  CLOSED
  CANCELLED
  EXPIRED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum ProposalSourceType {
  LEARNING_REQUEST
  DIRECT_SEARCH
}

enum LearningPathStatus {
  DRAFT
  PROPOSED
  PARTIALLY_CONFIRMED
  CONFIRMED
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
  DISPUTED
}

enum LearningPlanStatus {
  DRAFT
  PROPOSED
  CONFIRMED
  NEEDS_REVISION
}

enum ExchangeType {
  TWO_WAY
  ONE_WAY
}

enum FeePolicyCode {
  TWO_WAY
  ONE_WAY
  MATERIAL_PAID
}

enum HoldPurpose {
  COMMITMENT
  TEACHING_PAYMENT
}

enum ScheduleProposalStatus {
  DRAFT
  PROPOSED
  PARTIALLY_CONFIRMED
  LOCKED
  NEEDS_REVISION
  CANCELLED
  EXPIRED
}

enum SessionStatus {
  CONFIRMED
  READY
  ONGOING
  AWAITING_CONFIRMATION
  COMPLETED
  CANCELLED
  DISPUTED
}

enum CreditTransactionType {
  TOP_UP
  DAILY_BONUS
  FEEDBACK_BONUS
  HOLD
  RELEASE
  PATH_RETURN
  PLATFORM_FEE
  TEACHING_PAYMENT
  TEACHING_EARNING
  MATERIAL_PURCHASE
  MATERIAL_SALE
  REFUND
  PENALTY
  ADJUSTMENT
}

enum CreditReferenceType {
  PAYMENT
  LEARNING_PATH
  SESSION
  REVIEW
  DISPUTE
  MATERIAL_ORDER
  SYSTEM
}

enum CreditTransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
  REVIEW
  CANCELLED
}

enum MaterialAccessType {
  FREE
  PAID
}

enum MaterialStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  HIDDEN
  ARCHIVED
}

enum EntitlementSourceType {
  FREE
  PURCHASE
}

enum ReportTargetType {
  USER
  SESSION
  REVIEW
  MESSAGE
  LEARNING_REQUEST
  CREDIT_TRANSACTION
  MATERIAL
  MATERIAL_ORDER
}

enum ReportCaseStatus {
  OPEN
  UNDER_REVIEW
  NEED_MORE_INFO
  RESOLVED
  REJECTED
  CLOSED
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

model User {
  id                    String        @id @default(uuid()) @map("user_id") @db.Uuid
  roleId                String        @map("role_id") @db.Uuid
  normalizedEmail       String        @unique @map("normalized_email") @db.VarChar(254)
  passwordHash          String?       @map("password_hash") @db.Text
  accountStatus         AccountStatus @map("account_status")
  emailVerified         Boolean       @map("email_verified")
  securityVersion       Int           @map("security_version")
  failedLoginCount      Int           @map("failed_login_count")
  lastLoginAt           DateTime?     @map("last_login_at") @db.Timestamptz(3)
  termsVersion          String        @map("terms_version") @db.VarChar(40)
  termsAcceptedAt       DateTime      @map("terms_accepted_at") @db.Timestamptz(3)
  fullName              String        @map("full_name") @db.VarChar(100)
  headline              String?       @map("headline") @db.VarChar(120)
  bio                   String?       @map("bio") @db.VarChar(1000)
  avatarAssetId         String?       @map("avatar_asset_id") @db.Uuid
  timezone              String?       @map("timezone") @db.VarChar(64)
  locale                UserLocale    @map("locale")
  reputationScore       Int           @default(50) @map("reputation_score") @db.SmallInt
  verifiedSkillCount    Int           @map("verified_skill_count")
  completedSessionCount Int           @map("completed_session_count")
  selectedTitle         String?       @map("selected_title") @db.VarChar(80)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  selectedAvatarRecord                      AvatarAsset?            @relation("User_selected_avatar", fields: [id, avatarAssetId], references: [userId, id], onDelete: Restrict, onUpdate: Restrict)
  roleIdRecord                              Role                    @relation("User_role_id", fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  oAuthAccountUserIdRecords                 OAuthAccount[]          @relation("OAuthAccount_user_id")
  refreshSessionUserIdRecords               RefreshSession[]        @relation("RefreshSession_user_id")
  sharingSkillUserIdRecords                 SharingSkill[]          @relation("SharingSkill_user_id")
  skillVerificationReviewerIdRecords        SkillVerification[]     @relation("SkillVerification_reviewer_id")
  skillEvidenceReviewerIdRecords            SkillEvidence[]         @relation("SkillEvidence_reviewer_id")
  skillEvidenceRevokedByUserIdRecords       SkillEvidence[]         @relation("SkillEvidence_revoked_by_user_id")
  userLearnedSkillUserIdRecords             UserLearnedSkill[]      @relation("UserLearnedSkill_user_id")
  learningRequestOwnerIdRecords             LearningRequest[]       @relation("LearningRequest_owner_id")
  learningRequestReviewedByUserIdRecords    LearningRequest[]       @relation("LearningRequest_reviewed_by_user_id")
  proposalProposerIdRecords                 Proposal[]              @relation("Proposal_proposer_id")
  proposalRecipientIdRecords                Proposal[]              @relation("Proposal_recipient_id")
  conversationParticipantAIdRecords         Conversation[]          @relation("Conversation_participant_a_id")
  conversationParticipantBIdRecords         Conversation[]          @relation("Conversation_participant_b_id")
  scheduleVersionCreatedByUserIdRecords     ScheduleVersion[]       @relation("ScheduleVersion_created_by_user_id")
  sessionTeacherIdRecords                   Session[]               @relation("Session_teacher_id")
  sessionLearnerIdRecords                   Session[]               @relation("Session_learner_id")
  sessionCancelledByUserIdRecords           Session[]               @relation("Session_cancelled_by_user_id")
  creditWalletUserIdRecords                 CreditWallet?           @relation("CreditWallet_user_id")
  heldCreditAllocationUserIdRecords         HeldCreditAllocation[]  @relation("HeldCreditAllocation_user_id")
  heldCreditAllocationBeneficiaryIdRecords  HeldCreditAllocation[]  @relation("HeldCreditAllocation_beneficiary_id")
  paymentUserIdRecords                      Payment[]               @relation("Payment_user_id")
  systemConfigurationUpdatedByUserIdRecords SystemConfiguration[]   @relation("SystemConfiguration_updated_by_user_id")
  reviewReviewerIdRecords                   Review[]                @relation("Review_reviewer_id")
  reviewRevieweeIdRecords                   Review[]                @relation("Review_reviewee_id")
  reputationHistoryUserIdRecords            ReputationHistory[]     @relation("ReputationHistory_user_id")
  userAchievementUserIdRecords              UserAchievement[]       @relation("UserAchievement_user_id")
  reportCaseReporterIdRecords               ReportCase[]            @relation("ReportCase_reporter_id")
  reportCaseHandlerIdRecords                ReportCase[]            @relation("ReportCase_handler_id")
  reportCaseResolvedByUserIdRecords         ReportCase[]            @relation("ReportCase_resolved_by_user_id")
  notificationUserIdRecords                 Notification[]          @relation("Notification_user_id")
  pushDeviceTokenUserIdRecords              PushDeviceToken[]       @relation("PushDeviceToken_user_id")
  auditLogActorIdRecords                    AuditLog[]              @relation("AuditLog_actor_id")
  avatarAssetUserIdRecords                  AvatarAsset[]           @relation("AvatarAsset_user_id")
  identityEmailDeliveryUserIdRecords        IdentityEmailDelivery[] @relation("IdentityEmailDelivery_user_id")
  learningPathParticipantAIdRecords         LearningPath[]          @relation("LearningPath_participant_a_id")
  learningPathParticipantBIdRecords         LearningPath[]          @relation("LearningPath_participant_b_id")
  learningPathVersionTeacherIdRecords       LearningPathVersion[]   @relation("LearningPathVersion_teacher_id")
  learningPathVersionLearnerIdRecords       LearningPathVersion[]   @relation("LearningPathVersion_learner_id")
  learningPathVersionCreatedByUserIdRecords LearningPathVersion[]   @relation("LearningPathVersion_created_by_user_id")
  learningPlanTeacherIdRecords              LearningPlan[]          @relation("LearningPlan_teacher_id")
  learningPlanLearnerIdRecords              LearningPlan[]          @relation("LearningPlan_learner_id")
  learningPlanCreatedByUserIdRecords        LearningPlan[]          @relation("LearningPlan_created_by_user_id")
  feePolicyVersionApprovedByUserIdRecords   FeePolicyVersion[]      @relation("FeePolicyVersion_approved_by_user_id")
  materialOwnerIdRecords                    Material[]              @relation("Material_owner_id")
  materialReviewedByUserIdRecords           Material[]              @relation("Material_reviewed_by_user_id")
  materialOrderBuyerIdRecords               MaterialOrder[]         @relation("MaterialOrder_buyer_id")
  materialOrderSellerIdRecords              MaterialOrder[]         @relation("MaterialOrder_seller_id")
  materialEntitlementUserIdRecords          MaterialEntitlement[]   @relation("MaterialEntitlement_user_id")
  userRestrictionUserIdRecords              UserRestriction[]       @relation("UserRestriction_user_id")
  userRestrictionAppliedByUserIdRecords     UserRestriction[]       @relation("UserRestriction_applied_by_user_id")

  createdTags                 Tag[]                @relation("Tag_creator")
  tagCreationRequests         TagCreationRequest[] @relation("TagRequest_owner")
  reviewedTagCreationRequests TagCreationRequest[] @relation("TagRequest_reviewer")

  @@unique([id, avatarAssetId])
  @@index([roleId])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([accountStatus, createdAt(sort: Desc), id(sort: Desc)])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @map("role_id") @db.Uuid
  code        RoleCode @unique @map("code")
  description String?  @map("description") @db.VarChar(255)

  userRoleIdRecords           User[]           @relation("User_role_id")
  rolePermissionRoleIdRecords RolePermission[] @relation("RolePermission_role_id")

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @map("permission_id") @db.Uuid
  code        String  @unique @map("code") @db.VarChar(100)
  description String? @map("description") @db.VarChar(255)

  rolePermissionPermissionIdRecords RolePermission[] @relation("RolePermission_permission_id")

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  roleIdRecord       Role       @relation("RolePermission_role_id", fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  permissionIdRecord Permission @relation("RolePermission_permission_id", fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model OAuthAccount {
  id                String   @id @default(uuid()) @map("oauth_account_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  // Open vocabulary; owning feature must validate it before release.
  provider          String   @map("provider") @db.Text
  providerAccountId String   @map("provider_account_id") @db.VarChar(255)
  linkedAt          DateTime @map("linked_at") @db.Timestamptz(3)

  userIdRecord User @relation("OAuthAccount_user_id", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model RefreshSession {
  id                String    @id @default(uuid()) @map("session_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  securityVersion   Int       @map("security_version")
  currentGeneration Int       @map("current_generation")
  rememberMe        Boolean   @map("remember_me")
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason     String?   @map("revoked_reason") @db.Text
  deviceMetadata    Json?     @map("device_metadata")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  reauthProofBoundSessionRecords    ReauthProof[]       @relation("ReauthProof_bound_session")
  userIdRecord                      User                @relation("RefreshSession_user_id", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  refreshCredentialSessionIdRecords RefreshCredential[] @relation("RefreshCredential_session_id")

  @@unique([userId, id])
  @@index([userId])
  @@index([userId, revokedAt, absoluteExpiresAt])
  @@index([absoluteExpiresAt])
  @@map("refresh_sessions")
}

model SkillCategory {
  id               String        @id @default(uuid()) @map("category_id") @db.Uuid
  name             String        @unique @map("name") @db.VarChar(100)
  slug             String        @unique @map("slug") @db.VarChar(120)
  status           CatalogStatus @map("status")
  parentCategoryId String?       @map("parent_category_id") @db.Uuid

  parentCategoryIdRecord               SkillCategory?  @relation("SkillCategory_parent_category_id", fields: [parentCategoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  skillCategoryParentCategoryIdRecords SkillCategory[] @relation("SkillCategory_parent_category_id")
  skillCategoryIdRecords               Skill[]         @relation("Skill_category_id")

  @@index([parentCategoryId])
  @@map("skill_categories")
}

model Skill {
  id          String        @id @default(uuid()) @map("skill_id") @db.Uuid
  name        String        @unique @map("name") @db.VarChar(100)
  slug        String        @unique @map("slug") @db.VarChar(120)
  categoryId  String?       @map("category_id") @db.Uuid
  description String?       @map("description") @db.VarChar(500)
  status      CatalogStatus @map("status")

  categoryIdRecord                  SkillCategory?        @relation("Skill_category_id", fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sharingSkillSkillIdRecords        SharingSkill[]        @relation("SharingSkill_skill_id")
  userLearnedSkillSkillIdRecords    UserLearnedSkill[]    @relation("UserLearnedSkill_skill_id")
  learningRequestSkillIdRecords     LearningRequest[]     @relation("LearningRequest_skill_id")
  proposalSkillIdRecords            Proposal[]            @relation("Proposal_skill_id")
  learningPlanVersionSkillIdRecords LearningPlanVersion[] @relation("LearningPlanVersion_skill_id")
  materialSkillIdRecords            Material[]            @relation("Material_skill_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version   Int      @default(1)
  nameKey   String   @unique @map("name_key") @db.Text

  levels SkillLevel[]

  @@index([categoryId])
  @@map("skills")
}

model SharingSkill {
  id                 String                  @id @default(uuid()) @map("sharing_skill_id") @db.Uuid
  userId             String                  @map("user_id") @db.Uuid
  skillId            String                  @map("skill_id") @db.Uuid
  level              SharingSkillLevel?      @map("level")
  description        String                  @map("description") @db.VarChar(1500)
  experienceYears    Decimal?                @map("experience_years") @db.Decimal(3, 1)
  verificationStatus SkillVerificationStatus @map("verification_status")
  isVisible          Boolean                 @map("is_visible")
  archivedAt         DateTime?               @map("archived_at") @db.Timestamptz(3)

  userIdRecord                           User                @relation("SharingSkill_user_id", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  skillIdRecord                          Skill               @relation("SharingSkill_skill_id", fields: [skillId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  skillVerificationSharingSkillIdRecords SkillVerification[] @relation("SkillVerification_sharing_skill_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version   Int      @default(1)

  requestOfferings RequestOffering[] @relation("RequestOffering_sharing")
  levelId          String?           @map("level_id") @db.Uuid
  levelIdRecord    SkillLevel?       @relation(fields: [skillId, levelId], references: [skillId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId])
  @@index([skillId])
  @@index([skillId, levelId])
  @@map("sharing_skills")
}

model SkillVerification {
  id             String                    @id @default(uuid()) @map("verification_id") @db.Uuid
  sharingSkillId String                    @map("sharing_skill_id") @db.Uuid
  status         VerificationRequestStatus @map("status")
  reviewerId     String?                   @map("reviewer_id") @db.Uuid
  reviewedAt     DateTime?                 @map("reviewed_at") @db.Timestamptz(3)
  note           String?                   @map("note") @db.VarChar(500)
  rejectReason   String?                   @map("reject_reason") @db.VarChar(500)
  submittedAt    DateTime                  @map("submitted_at") @db.Timestamptz(3)

  skillEvidenceSubmissionRecords SkillEvidence[] @relation("SkillEvidence_submission")
  sharingSkillIdRecord           SharingSkill    @relation("SkillVerification_sharing_skill_id", fields: [sharingSkillId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviewerIdRecord               User?           @relation("SkillVerification_reviewer_id", fields: [reviewerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  version                        Int             @default(1)

  @@unique([id, sharingSkillId])
  @@index([sharingSkillId])
  @@index([reviewerId])
  @@map("skill_verifications")
}

model SkillEvidence {
  id              String                 @id @default(uuid()) @map("evidence_id") @db.Uuid
  verificationId  String                 @map("verification_id") @db.Uuid
  sharingSkillId  String                 @map("sharing_skill_id") @db.Uuid
  title           String?                @map("title") @db.VarChar(120)
  description     String?                @map("description") @db.VarChar(500)
  mimeType        String                 @map("mime_type") @db.VarChar(100)
  storageKey      String                 @map("storage_key") @db.VarChar(500)
  fileSizeBytes   BigInt                 @map("file_size_bytes")
  uploadedAt      DateTime               @map("uploaded_at") @db.Timestamptz(3)
  approvalStatus  EvidenceApprovalStatus @map("approval_status")
  reviewerId      String?                @map("reviewer_id") @db.Uuid
  reviewedAt      DateTime?              @map("reviewed_at") @db.Timestamptz(3)
  approvedAt      DateTime?              @map("approved_at") @db.Timestamptz(3)
  rejectReason    String?                @map("reject_reason") @db.VarChar(500)
  revokedByUserId String?                @map("revoked_by_user_id") @db.Uuid
  revokedAt       DateTime?              @map("revoked_at") @db.Timestamptz(3)
  revokedReason   String?                @map("revoked_reason") @db.Text
  // Open vocabulary; owning feature must validate it before release.
  scanStatus      String                 @map("scan_status") @db.Text
  checksum        String                 @map("checksum") @db.Text

  submissionRecord      SkillVerification @relation("SkillEvidence_submission", fields: [verificationId, sharingSkillId], references: [id, sharingSkillId], onDelete: Restrict, onUpdate: Restrict)
  reviewerIdRecord      User?             @relation("SkillEvidence_reviewer_id", fields: [reviewerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revokedByUserIdRecord User?             @relation("SkillEvidence_revoked_by_user_id", fields: [revokedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  storedFileId String?     @unique @map("stored_file_id") @db.Uuid
  storedFile   StoredFile? @relation(fields: [storedFileId], references: [id], onDelete: Restrict)

  @@index([verificationId, sharingSkillId])
  @@index([reviewerId])
  @@index([revokedByUserId])
  @@map("skill_evidence")
}

model UserLearnedSkill {
  id                    String   @id @default(uuid()) @map("learned_skill_id") @db.Uuid
  userId                String   @map("user_id") @db.Uuid
  skillId               String   @map("skill_id") @db.Uuid
  sourcePathId          String   @map("source_path_id") @db.Uuid
  sourcePlanId          String   @map("source_plan_id") @db.Uuid
  completedAt           DateTime @map("completed_at") @db.Timestamptz(3)
  completionRuleVersion String   @map("completion_rule_version") @db.VarChar(40)

  sourcePlanRecord LearningPlan @relation("UserLearnedSkill_source_plan", fields: [sourcePlanId, sourcePathId], references: [id, pathId], onDelete: Restrict, onUpdate: Restrict)
  userIdRecord     User         @relation("UserLearnedSkill_user_id", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  skillIdRecord    Skill        @relation("UserLearnedSkill_skill_id", fields: [skillId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([userId, skillId, sourcePlanId])
  @@index([sourcePlanId, sourcePathId])
  @@index([userId])
  @@index([skillId])
  @@map("user_learned_skills")
}

model LearningRequest {
  id                     String                  @id @default(uuid()) @map("request_id") @db.Uuid
  ownerId                String                  @map("owner_id") @db.Uuid
  skillId                String                  @map("skill_id") @db.Uuid
  title                  String                  @map("title") @db.VarChar(120)
  description            String                  @map("description") @db.VarChar(3000)
  learningGoal           String                  @map("learning_goal") @db.VarChar(1000)
  preferredSlots         Json                    @default("[]") @map("preferred_slots")
  currentLevel           LearningLevel?          @map("current_level")
  verifiedTeacherOnly    Boolean                 @default(false) @map("verified_teacher_only")
  version                Int                     @default(1) @map("content_version")
  // Open vocabulary; owning feature must validate it before release.
  moderationStatus       RequestModerationStatus @default(NOT_REQUIRED) @map("moderation_status")
  flaggedCategories      Json?                   @map("flagged_rules")
  moderationRejectReason String?                 @map("reject_reason") @db.VarChar(500)
  moderatedByUserId      String?                 @map("reviewed_by_user_id") @db.Uuid
  moderatedAt            DateTime?               @map("reviewed_at") @db.Timestamptz(3)
  expiresAt              DateTime?               @map("expires_at") @db.Timestamptz(3)
  status                 LearningRequestStatus   @default(DRAFT) @map("status")
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  ownerIdRecord                User           @relation("LearningRequest_owner_id", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  skillIdRecord                Skill          @relation("LearningRequest_skill_id", fields: [skillId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  moderatedBy                  User?          @relation("LearningRequest_reviewed_by_user_id", fields: [moderatedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  proposalRequestIdRecords     Proposal[]     @relation("Proposal_request_id")
  conversationRequestIdRecords Conversation[] @relation("Conversation_request_id")

  moderationRuleSetVersion  Int?              @map("moderation_rule_set_version")
  moderationReviewedVersion Int?              @map("moderation_reviewed_version")
  requestedExpiresAt        DateTime?         @map("requested_expires_at") @db.Timestamptz(3)
  expiryMode                RequestExpiryMode @default(DEFAULT) @map("expiry_mode")
  publishedAt               DateTime?         @map("published_at") @db.Timestamptz(3)
  tagLinks                  RequestTag[]      @relation("RequestTag_request")
  teachingOverview          String?           @map("teaching_overview") @db.VarChar(3000)
  preferredAvailability     Json?             @map("preferred_availability")
  desiredCreditPerHour      BigInt?           @map("desired_credit_per_hour")
  offeringLinks             RequestOffering[] @relation("RequestOffering_request")

  @@index([ownerId])
  @@index([skillId])
