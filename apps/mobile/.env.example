# SkillHub Mobile - local environment template.
# API URL must end in /api or /api/v1. Authentication uses this value at runtime.
EXPO_PUBLIC_API_URL=https://api.example.com/api/v1
# On a physical device, replace localhost with your development machine's LAN IP.
# EXPO_PUBLIC_ variables are public; do not put secrets here.
# LiveKit URL/token come from the authenticated Session API above.
# LIVEKIT_API_KEY/LIVEKIT_API_SECRET belong only in the backend runtime.
