# SkillHub Flutter - client environment template.
# Values here are compiled into the app and are public; never put backend secrets here.
# API URL must end in /api or /api/v1.
# `flutter run` already uses https://skillhub.memora.cam/api/v1.
# Override with --dart-define=API_URL=... (Android emulator host is 10.0.2.2).
API_URL=https://skillhub.memora.cam/api/v1
